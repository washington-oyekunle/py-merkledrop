pragma solidity ^0.8.19;

/**
 * @title MerkleAirdrop
 * @notice Gas-efficient Merkle airdrop claim contract.
 *         Compatible with py-merkledrop when using --algo keccak256.
 *
 * Leaf = keccak256(abi.encodePacked(account, amount))
 * Tree uses sorted pairs (left < right before hashing).
 */
interface IERC20 {
    function transfer(address to, uint256 amount) external returns (bool);
}

contract MerkleAirdrop {
    bytes32 public immutable merkleRoot;
    IERC20 public immutable token;
    address public owner;

    mapping(address => bool) public hasClaimed;

    event Claimed(address indexed account, uint256 amount);
    event OwnershipTransferred(address indexed previousOwner, address indexed newOwner);

    error AlreadyClaimed();
    error InvalidProof();
    error TransferFailed();
    error NotOwner();

    constructor(bytes32 _merkleRoot, address _token) {
        merkleRoot = _merkleRoot;
        token = IERC20(_token);
        owner = msg.sender;
    }

    modifier onlyOwner() {
        if (msg.sender != owner) revert NotOwner();
        _;
    }

    /**
     * @notice Claim tokens for the caller.
     * @param amount Token amount (must match the leaf used to build the tree).
     * @param proof Merkle proof generated by py-merkledrop.
     */
    function claim(uint256 amount, bytes32[] calldata proof) external {
        if (hasClaimed[msg.sender]) revert AlreadyClaimed();
        if (!_verify(msg.sender, amount, proof)) revert InvalidProof();

        hasClaimed[msg.sender] = true;

        bool ok = token.transfer(msg.sender, amount);
        if (!ok) revert TransferFailed();

        emit Claimed(msg.sender, amount);
    }

    /**
     * @notice Verify a proof offline or for front-end checks.
     */
    function verify(address account, uint256 amount, bytes32[] calldata proof)
        external
        view
        returns (bool)
    {
        return _verify(account, amount, proof);
    }

    function _verify(address account, uint256 amount, bytes32[] calldata proof)
        internal
        view
        returns (bool)
    {
        bytes32 leaf = keccak256(abi.encodePacked(account, amount));
        bytes32 computed = leaf;

        for (uint256 i = 0; i < proof.length; ) {
            bytes32 sibling = proof[i];
            if (computed <= sibling) {
                computed = keccak256(abi.encodePacked(computed, sibling));
            } else {
                computed = keccak256(abi.encodePacked(sibling, computed));
            }
            unchecked {
                ++i;
            }
        }
        return computed == merkleRoot;
    }

    function transferOwnership(address newOwner) external onlyOwner {
        emit OwnershipTransferred(owner, newOwner);
        owner = newOwner;
    }

    /**
     * @notice Rescue tokens that were sent by mistake (after claims finish).
     */
    function rescueTokens(address to, uint256 amount) external onlyOwner {
        bool ok = token.transfer(to, amount);
        if (!ok) revert TransferFailed();
    }
}
